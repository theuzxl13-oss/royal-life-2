# Copie para .env.local e preencha. NUNCA versione o arquivo .env.local.
# Dados do projeto Supabase (Project Settings > API). A chave "anon" é pública por design;
# a segurança é garantida pelas políticas RLS do arquivo supabase/schema.sql.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# URL pública do site (usada em SEO / links canônicos). Opcional.
VITE_SITE_URL=https://www.seudominio.com.br

# Subpasta de publicação (ex.: /royal-life-2/ no GitHub Pages). Padrão: /
# VITE_BASE_PATH=/

# Somente para pré-visualização sem banco: "true" ativa o modo demonstração
# (dados salvos apenas no navegador). Em produção deixe vazio.
# VITE_DEMO_MODE=true
